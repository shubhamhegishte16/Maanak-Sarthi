PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=admin@maanaksaarthi.in
ADMIN_PASSWORD=change_this_secure_password
# Google Gemini API Keys
GEMINI_API_KEY=your_gemini_api_key_for_assistant
GEMINI_API_KEY_DOC_ANALYZER=your_doc_analyzer_key_here
GEMINI_API_KEY_FIND_STANDARD=your_find_standard_key_here
GEMINI_API_KEY_COMPARE=your_compare_key_here

GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_RATE_LIMIT=30
